<?xml version="1.0" encoding="UTF-8"?>
<!-- GRACE 5 v0: records/approval-<rev>.xml. The owner decision on one contract revision. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:include schemaLocation="common.xsd"/>

  <xs:element name="Approval">
    <xs:complexType>
      <xs:sequence>
        <!-- Statement: an approval's single word "approved", or a rejection's reason. Optional: an approval needs no words. -->
        <xs:element name="Statement" type="Text" minOccurs="0"/>
        <!-- Source: legacy in records already written, where the statement was said. The kernel ignores it; a new record omits it. -->
        <xs:element name="Source" type="Text" minOccurs="0"/>
        <!-- Bound: one per check of the approved revision with the hash of its definition, so run can tell an approved check from an amended one. -->
        <xs:element name="Bound" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
          <xs:attribute name="check" type="xs:NCName" use="required"/>
          <xs:attribute name="definition-sha256" type="Sha256" use="required"/>
        </xs:complexType></xs:element>
        <!-- Legacy Execution element: accepted for records already written and ignored by the kernel. New records omit it. -->
        <xs:element name="Execution" minOccurs="0"><xs:complexType>
          <xs:sequence>
            <xs:element name="Statement" type="Text"/>
            <xs:element name="Source" type="Text"/>
          </xs:sequence>
          <xs:attribute name="date" type="xs:date" use="required"/>
        </xs:complexType></xs:element>
      </xs:sequence>
      <xs:attributeGroup ref="Binding"/>
      <!-- brief-sha256: legacy. The hash of the brief page the owner read, in a record already written; a legacy
           approval keeps that obligation. A new approval carries no brief, omits this attribute, and binds the
           contract text and each check definition instead (authorization.md, C-0019). -->
      <xs:attribute name="brief-sha256" type="Sha256" use="optional"/>
      <xs:attribute name="date" type="xs:date" use="required"/>
      <!-- Legacy personal attribution: accepted in existing records and ignored; new records omit it. -->
      <xs:attribute name="owner" type="Text" use="optional"/>
      <xs:attribute name="decision" use="required"><xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="approved"/><xs:enumeration value="rejected"/>
      </xs:restriction></xs:simpleType></xs:attribute>
      <!-- Legacy executes attribute: accepted for records already written and ignored by the kernel. New records omit it. -->
      <xs:attribute name="executes" type="xs:boolean" use="optional"/>
      <xs:attribute name="recorded-by" type="Text" use="optional"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
